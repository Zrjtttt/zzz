# ============================================================
# НАСТРОЙКИ AI-ПРОВАЙДЕРА (OpenAI-совместимый API)
# ============================================================
#
# По умолчанию используется OpenRouter + DeepSeek.
# Чтобы подключить свою модель (например, внутри банка):
#   1. Скопируйте этот файл в .env
#   2. Измените значения ниже
#   3. Перезапустите приложение
#
# API-ключ вводится в боковой панели приложения, НЕ здесь.
# ============================================================

# URL endpoint (должен быть OpenAI-совместимым)
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Название модели
AI_MODEL=deepseek/deepseek-chat-v3-0324

# ============================================================
# ПРИМЕРЫ ДЛЯ РАЗНЫХ ПРОВАЙДЕРОВ
# ============================================================
#
# OpenRouter + DeepSeek (по умолчанию):
#   AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
#   AI_MODEL=deepseek/deepseek-chat-v3-0324
#
# OpenAI напрямую:
#   AI_BASE_URL=https://api.openai.com/v1/chat/completions
#   AI_MODEL=gpt-4o-mini
#
# Ollama (локально):
#   AI_BASE_URL=http://localhost:11434/v1/chat/completions
#   AI_MODEL=llama3.1:70b
#
# Банковский API (OpenAI-совместимый):
#   AI_BASE_URL=https://bank-ai.local/v1/chat/completions
#   AI_MODEL=bank-llm-v1
